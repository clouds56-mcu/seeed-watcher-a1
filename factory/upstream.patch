+esp_err_t app_vi_pause_for_spectrum(bool *resume_taskflow) {
+  *resume_taskflow = false;
+  if (!gp_voice_interaction) return ESP_OK;
+  struct app_voice_interaction *p_vi = gp_voice_interaction;
+  *resume_taskflow = p_vi->taskflow_pause;
+  xEventGroupClearBits(p_vi->event_group, EVENT_RECORD_START);
+  __vi_exit(p_vi);
+  for (int i = 0; i < 100; ++i) {
+    if (p_vi->cur_status == VI_STATUS_IDLE && !p_vi->is_recording &&
+        !(xEventGroupGetBits(p_vi->event_group) & EVENT_VI_EXIT)) return ESP_OK;
+    vTaskDelay(pdMS_TO_TICKS(20));
+  }
+  return ESP_ERR_TIMEOUT;
+}
